{
  "id": "/collection",
  "name": "Tablist",
  "short_name": "Tablist",
  "description": "Import your BoardGameGeek collection, filter what fits tonight's table, and keep a lasting record of every game night.",
  "start_url": "/collection",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#012d1d",
  "background_color": "#f2f0ea",
  "categories": ["games", "entertainment", "utilities"],
  "icons": [
    {
      "src": "/favicon/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Random Game",
      "short_name": "Random",
      "description": "Pick a random game from your collection",
      "url": "/collection?random=1",
      "icons": [
        {
          "src": "/favicon/web-app-manifest-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My Collection",
      "short_name": "Collection",
      "description": "Browse your board game collection",
      "url": "/collection",
      "icons": [
        {
          "src": "/favicon/web-app-manifest-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New Session",
      "short_name": "Session",
      "description": "Start a new game night session",
      "url": "/sessions/new",
      "icons": [
        {
          "src": "/favicon/web-app-manifest-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "widgets": [
    {
      "name": "Random Game",
      "short_name": "Random",
      "description": "Pick a random game from your Tablist collection",
      "tag": "random-game",
      "template": "tablist-random-game",
      "ms_ac_template": "/widgets/random-game-template.json",
      "data": "/widgets/random-game-data.json",
      "type": "application/json",
      "auth": true,
      "update": 86400,
      "icons": [
        {
          "src": "/favicon/web-app-manifest-192x192.png",
          "sizes": "192x192"
        }
      ],
      "screenshots": [
        {
          "src": "/widgets/random-game-screenshot.png",
          "sizes": "600x400",
          "label": "Random game widget"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/landing/screenshot.png",
      "sizes": "1904x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Tablist collection and sessions"
    },
    {
      "src": "/landing/screenshot_mobile.png",
      "sizes": "486x931",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Tablist on mobile"
    }
  ]
}
