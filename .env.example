NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — Supabase service role key (Settings → API).
# Required for account deletion. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Required — BoardGameGeek Application Token (Bearer).
# Register an app at https://boardgamegeek.com/applications, get approval,
# then create a token and paste it here. XML API2 returns 401 without it.
BGG_API_KEY=

# --- Tablist MCP (packages/mcp-server) — client env, not Next.js ---
# Preferred: personal access token from Profile → Agents (tab_…).
# TABLIST_API_TOKEN=
# TABLIST_API_BASE=https://tablist.app
# Dev-only prototype: temporary Supabase access JWT (expires).
# TABLIST_ACCESS_TOKEN=
