{
  "name": "@tablist/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Tablist domain MCP server (collection, sessions, BGG via Tablist HTTPS API)",
  "type": "module",
  "bin": {
    "tablist-mcp": "./src/stdio.ts"
  },
  "exports": {
    ".": "./src/server.ts",
    "./client": "./src/client.ts",
    "./setup-text": "./src/setup-text.ts"
  },
  "scripts": {
    "start": "tsx src/stdio.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
